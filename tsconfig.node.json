{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "emitDeclarationOnly": true,
    "outDir": ".tanstack/types-node",
    "tsBuildInfoFile": ".tanstack/types-node/tsconfig.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/build-info.mjs",
    "scripts/platform-vite.ts",
    "scripts/platforms.mjs"
  ]
}
