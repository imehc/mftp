{
  "name": "mftp",
  "private": true,
  "version": "0.2.7",
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-frontend.mjs",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "android:dev": "bash scripts/android.sh dev",
    "android:build": "bash scripts/android.sh build",
    "android:icons": "node scripts/android-icons.mjs",
    "android:network-security": "node scripts/android-network-security.mjs",
    "macos:icons": "node scripts/macos-icons.mjs",
    "ios:icons": "node scripts/ios-icons.mjs",
    "ios:dev": "pnpm tauri ios dev",
    "ios:build": "pnpm tauri ios build",
    "check:dev-isolation": "node --test tests/checks/dev-isolation.test.mjs",
    "check:react": "node tests/checks/check-react-versions.mjs",
    "check:model-offline": "node tests/checks/check-model-offline.mjs",
    "check:build-budget": "node tests/checks/check-build-budget.mjs",
    "check:platform": "node --test tests/checks/platform-packaging.test.mjs",
    "check:form-errors": "node --test tests/checks/form-error-semantics.test.mjs",
    "check:ui-guards": "node --test tests/checks/ui-guardrails.test.mjs",
    "check:platform-artifact": "node tests/checks/check-platform-artifact.mjs",
    "check:android-plugins": "node tests/checks/check-android-plugins.mjs",
    "check:app-icon-artifact": "node tests/checks/check-app-icon-artifact.mjs",
    "check:app-icons": "node --test tests/checks/app-icon-capabilities.test.mjs tests/checks/desktop-app-icons.test.mjs",
    "routes:generate": "node scripts/generate-routes.mjs",
    "fonts:subset": "node scripts/subset-cjk-fonts.mjs",
    "translation:prepare": "node scripts/prepare-translation-engine.mjs",
    "bindings:generate": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib export_typescript_bindings",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "git cz",
    "prepare": "simple-git-hooks",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:update": "pnpm dlx skills update -y"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
