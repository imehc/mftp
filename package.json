    "@fontsource/noto-serif-sc": "^5.3.1",
    "@fontsource/space-mono": "^5.3.0",
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@ncdai/react-wheel-picker": "1.2.3",
